{
    "name": "fanat98/laravel-task-orchestrator",
    "description": "Lightweight Laravel dashboard for orchestrating Artisan command workflows with dependencies, pipelines, scheduling, queue health checks and stale run recovery.",
    "type": "library",
    "keywords": [
        "laravel",
        "laravel-package",
        "task-orchestration",
        "task-scheduler",
        "laravel-scheduler",
        "queue",
        "queue-monitoring",
        "dashboard",
        "pipeline",
        "workflow",
        "artisan",
        "monitoring",
        "devops"
    ],
    "homepage": "https://github.com/fanat98/laravel-task-orchestrator",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/fanat98/laravel-task-orchestrator/issues",
        "source": "https://github.com/fanat98/laravel-task-orchestrator"
    },
    "autoload": {
        "psr-4": {
            "Malsa\\TaskOrchestrator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Malsa\\TaskOrchestrator\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Malsa\\TaskOrchestrator\\TaskOrchestratorServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "dragonmantank/cron-expression": "^3.4"
    },
    "require-dev": {
        "innmind/black-box": "^6.0",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^12.5"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
